def average(array):
    sum = 0
    for value in array:
        sum += value
    result = sum / len(array)
    return result

def bubble_sort(array, order):
    for i in range(len(array) - 1):
        for j in range(len(array) - 1 ):
            if order == "A":
                if array[j] > array[j+1]:
                    array[j], array[j+1] = swap(array[j], array[j+1])
            else:
                if array[j] < array[j+1]:
                    array[j], array[j+1] = swap(array[j], array[j+1])
    return array

def swap(x,y):
    temp = x
    x = y
    y = temp
    return x, y
def minimum(x,y):
